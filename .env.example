# Web (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3100
API_URL=http://127.0.0.1:3001

# API (Fastify)
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://lpi:lpi@localhost:5432/lpi_tracking

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
COOKIE_SECURE=false

# File storage (local volume for MVP)
FILE_STORAGE_PATH=./data/uploads

# Docker deploy (docker compose -f docker-compose.deploy.yml up)
# DATABASE_URL is overridden to postgresql://lpi:lpi@postgres:5432/lpi_tracking
# API_URL inside the web container is http://api:3001
# NEXT_PUBLIC_APP_URL should match the URL opened in the browser, e.g. http://localhost:3100

# TransVoyant integration
# mock = local/CI without vendor calls; http = staging/production HTTP client
TRANSVOYANT_MODE=mock
TRANSVOYANT_BASE_URL=https://api-staging.transvoyant.com
TRANSVOYANT_TOKEN_URL=https://api-staging.transvoyant.com/uaa/v1/oauth/token
TRANSVOYANT_CLIENT_ID=
TRANSVOYANT_CLIENT_SECRET=
TRANSVOYANT_TIMEOUT_MS=15000

# Worker (pg-boss)
WORKER_CONCURRENCY=2
